@model Book

@{
    ViewData["Title"] = Model.Title;
}

<h1>@Model.Title</h1>

<p><strong>Author:</strong> @Model.Author</p>

<p><strong>Pages:</strong> @Model.Pages</p>

<p>
    <strong>Status:</strong>
    @if (Model.IsRead)
    {
        <span class="badge bg-success">Read</span>
    }
    else
    {
        <span>Not read yet</span>
    }
</p>

<div class="mt-3">
    @if (Model.Id > 1)
    {
        <a asp-controller="Books"
           asp-action="Details"
           asp-route-id="@(Model.Id - 1)"
           class="btn btn-secondary">
            Prev
        </a>
    }

    @if (Model.Id < ViewBag.LastId)
    {
        <a asp-controller="Books"
           asp-action="Details"
           asp-route-id="@(Model.Id + 1)"
           class="btn btn-primary">
            Next
        </a>
    }
</div>

<div class="mt-3">
    <a asp-controller="Books" asp-action="Index">Back to My shelf</a>
    {
    }
}
